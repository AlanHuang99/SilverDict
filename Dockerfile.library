FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e AS builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev liblzo2-dev git && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY requirements-library.lock .
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements-library.lock

FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
RUN apt-get update && apt-get install -y --no-install-recommends liblzo2-2 ffmpeg && rm -rf /var/lib/apt/lists/* && useradd --uid 1000 --create-home silverdict
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SILVERDICT_LIBRARY=1 SILVERDICT_SOURCE=/dictionaries SILVERDICT_STATE=/state SILVERDICT_CACHE=/library/cache SILVERDICT_LIBRARY_DATA=/library
WORKDIR /app/server
COPY server /app/server
COPY COPYING /app/COPYING
RUN mkdir -p /state /library /dictionaries && chown silverdict:silverdict /state /library /dictionaries
USER 1000:1000
EXPOSE 2628
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:2628/api/library/health', timeout=4)"
LABEL org.opencontainers.image.source="https://github.com/AlanHuang99/SilverDict" org.opencontainers.image.title="SilverDict Personal Library" org.opencontainers.image.licenses="GPL-3.0-or-later"
CMD ["python", "server.py", "0.0.0.0:2628"]
